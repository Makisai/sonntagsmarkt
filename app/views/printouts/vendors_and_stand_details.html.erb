<!doctype html>
<html>
  <head>
    <meta charset='utf-8' />
    <%= wicked_pdf_stylesheet_link_tag "pdf" %>
  </head>

  <body>

    <h2 class="card-title">Angaben zum Standinhabenden</h2>
    <div class="row">
      <div class="col-md-6">
        <h4><strong>Name des Betreibenden/Ausstellenden:</strong> <%= @vendor.name %></h4>
        <p><strong>Rechtsform:</strong> <%= @vendor.legalform %></p>
        <p><strong>Ansprechpartner*in:</strong> <%= @vendor.contact %></p>
        <p><strong>Adresse:</strong> <%= @vendor.address %></p>
      </div>
      <div class="col-md-6">
        <p><strong>Steuernummer:</strong> <%= @vendor.taxnumber %></p>
        <p><strong>Zuständiges Finanzamt:</strong> <%= @vendor.taxoffice %></p>
      </div>
    </div>
    <div class="row mt-3">
      <div class="col-md-6">
        <p><strong>Telefon/Mobilfunknummer:</strong> <%= @vendor.phone %></p>
        <p><strong>E-Mail-Adresse:</strong> <%= @vendor.email %></p>
      </div>
      <div class="col-md-6">
        <p><strong>Letzter Besuch:</strong> <%= @vendor.last_visit %></p>
        <p><strong>Besuchstag:</strong> <%= @vendor.visit_day %></p>
      </div>
    </div>

  <div id="<%= dom_id @stand %>" class="card m-3">
    <div class="card-body">
      <h5 class="card-title">Stand Details</h5>
      <div class="row">
        <div class="col-md-6">
          <p><strong>Frontmeter:</strong> <%= @stand.width %></p>
          <p><strong>Höhe:</strong> <%= @stand.height %></p>
          <p><strong>Tiefe:</strong> <%= @stand.depth %></p>
          <p><strong>Durchmesser:</strong> <%= @stand.diameter %></p>
        </div>
        <div class="col-md-6">
          <p><strong>Beschreibung:</strong> <%= @stand.description %></p>
          <p><strong>Kühlwagen:</strong> <%= @stand.cooler %></p>
          <p><strong>Tische/Schirme:</strong> <%= @stand.table %></p>
          <p><strong>Selbstfahrer:</strong> <%= @stand.selfdriver %></p>
        </div>
      </div>
      <div class="row mt-3">
        <div class="col-md-6">
          <p><strong>Anhänger:</strong> <%= @stand.trailer %></p>
          <p><strong>Stromanschluss (230 V):</strong> <%= @stand.power %></p>
          <p><strong>andere Besonderheiten:</strong> <%= @stand.specials %></p>
        </div>
        <div class="col-md-6">
          <p><strong>Sonstiges:</strong> <%= @stand.misc %></p>
          <p><strong>Händler:</strong> <%= @stand.vendor_id %></p>
        </div>
      </div>
    </div>
  </div>

</body>
</html>